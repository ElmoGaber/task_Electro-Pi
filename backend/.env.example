PORT=5000

# Optional — leave empty to use an in-memory MongoDB (auto-starts on first run)
# For a real database, use MongoDB Atlas or local mongod:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/taskmanager
# MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
MONGO_URI=

JWT_SECRET=dev-secret-key-change-in-production-123456

CLIENT_URL=http://localhost:5173

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
